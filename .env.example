# Environment & Runtime
ENVIRONMENT=development
DEMO_MODE=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data_quality.db

# Authentication (Keycloak OIDC)
OIDC_ISSUER_URL=http://localhost:8080/realms/data-quality-auditor
OIDC_AUDIENCE=data-quality-auditor
JWT_SECRET=

# LLM Configuration (Keys server-side only; leave blank for deterministic offline mode)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
